# NAVER API HUB > Search > Local Search credentials.
NAVER_API_HUB_CLIENT_ID=your-naver-api-hub-client-id
NAVER_API_HUB_CLIENT_SECRET=your-naver-api-hub-client-secret

# Backward-compatible fallback names. Prefer NAVER_API_HUB_* for new setups.
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Optional: Naver Cloud Platform Maps keys for geocoding.
# If omitted, the app still works but distance ranking is limited.
NAVER_MAPS_CLIENT_ID=your-naver-maps-client-id
NAVER_MAPS_CLIENT_SECRET=your-naver-maps-client-secret

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
REQUEST_TIMEOUT_SECONDS=8

# Set true while debugging to print the exact messages sent to Ollama.
LOG_PROMPTS=false
